# Only read when explicitly supplied: node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=3000
DEMO_ENABLED=true
COOKIE_SECURE=false
# Only used on FIRST initialization. A password change is still required on first login.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=Set-a-unique-initial-password
# Required when exposing through an HTTPS reverse proxy; origin without trailing slash.
# PUBLIC_ORIGIN=https://squadriglie.example.org
# COOKIE_SECURE=true
